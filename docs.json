{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kokonut Network",
  "colors": {
    "primary": "#009F4D",
    "light": "#ffffff",
    "dark": "#009F4D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "tree-palm",
        "pages": [
          "home/landing"
        ]
      },
      {
        "tab": "Ecosystem Wiki",
        "icon": "newspaper",
        "pages": [
          "ecosystem-wiki/faq",
          {
            "group": "Kokonut 101",
            "icon": "book-open-reader",
            "pages": [
              "ecosystem-wiki/kokonut-101/executive-summary",
              "ecosystem-wiki/kokonut-101/kokonut-vision"
            ]
          }
        ]
      },
      {
        "tab": "Kokonut Framework",
        "icon": "puzzle"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@kokonut.network"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Let's Connect",
      "href": "https://link.kokonut.network/meeting"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/KokonutNetwork",
      "github": "https://github.com/wasalo/Kokonut-Public-Site",
      "linkedin": "https://www.linkedin.com/company/kokonutnetwork",
      "discord": "https://link.kokonut.network/discord"
    }
  },
  "seo": {
    "indexing": "all"
  },
  "description": "Distributed Network powered by Biodiversity, Trees & People 🏕️🌳",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  }
}
